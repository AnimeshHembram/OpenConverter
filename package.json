{
  "name": "openconvert",
  "version": "0.1.0",
  "description": "Free, open-source file converter that runs entirely in your browser. No uploads, no accounts.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite --open",
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/build-standalone.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "build:standalone": "node scripts/build-standalone.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium --project=mobile-chromium",
    "test:e2e:pages": "playwright test -c playwright.pages.config.ts",
    "test:e2e:pages:chromium": "playwright test -c playwright.pages.config.ts --project=chromium --project=mobile-chromium",
    "test:all": "npm run typecheck && npm test && npm run build && npm run test:e2e && npm run build:pages && npm run test:e2e:pages",
    "test:all:chromium": "npm run typecheck && npm test && npm run build && npm run test:e2e:chromium && npm run build:pages && npm run test:e2e:pages:chromium",
    "fixtures": "playwright test -c tests/fixtures/playwright.fixtures.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.15.30",
    "typescript": "5.8.3",
    "vite": "6.4.4",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@jsquash/webp": "1.5.0"
  }
}
